# Copy this file to .env (or export these in your shell) before running the app.

# Required: your Anthropic API key, used for all five LLM stages.
ANTHROPIC_API_KEY=your_key_here

# Optional: override the default model used for every stage.
# ADVISOR_LLM_MODEL=claude-sonnet-5

# Optional: set to 1 to get a public Gradio share link.
# GRADIO_SHARE=1
